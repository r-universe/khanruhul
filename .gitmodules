[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "BMeRL"]
	path = BMeRL
	url = https://github.com/cran/BMeRL
[submodule "ROCModels"]
	path = ROCModels
	url = https://github.com/cran/ROCModels
[submodule "smoothROC"]
	path = smoothROC
	url = https://github.com/cran/smoothROC
